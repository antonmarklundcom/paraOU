# ── DNCP API (Portal de Datos Abiertos) ─────────────────────────────
# From your application at https://www.contrataciones.gov.py/datos/adm
# NEVER commit the real values; copy this file to .env and fill in.
DNCP_CONSUMER_KEY=your-customer-key-uuid
DNCP_CONSUMER_SECRET=your-customer-secret-uuid
# Base64 request token shown in the portal ("Request token")
DNCP_REQUEST_TOKEN=your-base64-request-token
# Token endpoints exactly as shown in the portal (unversioned path)
DNCP_TOKEN_URL=https://contrataciones.gov.py/datos/api/oauth/token
DNCP_INVALIDATE_URL=https://contrataciones.gov.py/datos/api/oauth/invalidate_token
# Data API base (verify against live Swagger in Phase 1, step 2)
DNCP_API_BASE=https://contrataciones.gov.py/datos/api/v3
# Rate limiter (docs/01: hard cap 5,000 req/15min — stay well under). Optional.
DNCP_MAX_REQUESTS_PER_SECOND=3
DNCP_MAX_REQUESTS_PER_WINDOW=3000

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://paraou:paraou@localhost:5432/paraou

# ── AI (Phase 4) ────────────────────────────────────────────────────
AI_PROVIDER=gemini            # gemini (default) | anthropic
GEMINI_API_KEY=
# pgvector dimension — changing it requires a migration + re-embedding (docs/04)
EMBEDDING_DIM=768
# Daily spend ceiling: the kill switch pauses LLM judging + summaries past this
AI_DAILY_BUDGET_USD=5
# Model ids (env-overridable; defaults verified against the live API 2026-07).
# Newer families (gemini-3.x) exist — upgrade here, not in code.
#GEMINI_MODEL_JUDGE=gemini-2.5-flash-lite
#GEMINI_MODEL_SUMMARY=gemini-2.5-flash
#GEMINI_MODEL_ANALYSIS=gemini-2.5-pro
#GEMINI_MODEL_EMBEDDING=gemini-embedding-001
# Optional alternative provider:
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# ── Admin (Phase 4) ─────────────────────────────────────────────────
# /admin/ai is 404 unless this is set and passed as ?key=… (kept for backward
# compat; /admin (Phase 6) uses session-based ADMIN_EMAILS below instead)
ADMIN_KEY=

# ── Auth & email (Phase 5) ──────────────────────────────────────────
# Required in production (openssl rand -base64 32); without it Auth.js falls
# back to an insecure dev default — fine for local dev, never deploy without it.
AUTH_SECRET=
# Only needed if the app is served from something other than the request's own
# host/port (e.g. behind a reverse proxy that rewrites Host).
AUTH_URL=
# Magic-link + digest email. Without a key, mail is logged to the console
# instead of sent (CLAUDE.md rule 2) — fine for local dev.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ParaOU <onboarding@resend.dev>
# Optional — Google sign-in is only offered when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Alert engine tunables (docs/03/05).
ALERT_MIN_MATCH_SCORE=70
ALERT_DIGEST_MAX_ITEMS=10

# ── Billing (Phase 6) ───────────────────────────────────────────────
# Without these, /precios shows "contact us" instead of Stripe Checkout
# (CLAUDE.md rule 2) — safe to launch on manual/bank-transfer billing only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids created in the Stripe dashboard (docs/08-launch.md step 5).
# Annual = 2 months free — set that up as the Price's actual amount in Stripe.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
# Business-tier "Analizar pliego" cap per user per calendar month.
DOCUMENT_ANALYSIS_MONTHLY_QUOTA=30

# ── API layer (Phase 2) ─────────────────────────────────────────────
# Fallback PYG-per-USD rate used when the ExchangeRate table is empty.
DEFAULT_PYG_PER_USD=7300
# Per-IP request budget (per minute) for public API endpoints.
API_RATE_LIMIT_PER_MIN=60

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated allowlist for the session-gated /admin dashboard (Phase 6).
ADMIN_EMAILS=antonmarklund.com@gmail.com
# Runtime + logging (optional; sensible defaults)
NODE_ENV=development
LOG_LEVEL=info

# ── Launch ops (docs/08 #9) ─────────────────────────────────────────
# Cookieless analytics (Plausible/Umami). Leave blank to omit the script
# entirely (no cookie-consent banner needed either way).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
