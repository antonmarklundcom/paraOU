// ParaOU data model — Phases 1 (ingestion) + 4 (profiles, AI matching) +
// 5 (accounts, saved searches, alerts). See docs/03-data-model.md. Phase 6 billing.
//
// Special columns managed by hand-written SQL in the migration (Prisma can't model
// them): Tender.searchVector is a GENERATED tsvector (spanish + unaccent) with a GIN
// index; Tender.embedding is a pgvector column with an HNSW cosine index (populated
// in Phase 4). They are declared here as Unsupported(...) so the client is aware of
// them and migrate diff stays consistent.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, unaccent, pg_trgm]
}

enum TenderStatus {
  PLANNED
  OPEN
  CLOSED
  AWARDED
  CONTRACTED
  CANCELLED
  UNSUCCESSFUL
}

model Tender {
  id                String       @id @default(cuid())
  ocid              String       @unique
  dncpId            String?
  title             String
  description       String?
  status            TenderStatus
  buyerId           String?
  buyerName         String? // denormalized for FTS + list display
  categoryCode      String?
  categoryName      String?
  procurementMethod String?
  amountMin         Decimal?     @db.Decimal(20, 4)
  amountMax         Decimal?     @db.Decimal(20, 4)
  currency          String       @default("PYG")
  department        String?
  publishedAt       DateTime?
  deadlineAt        DateTime?
  inquiryDeadlineAt DateTime?
  documentsUrl      String?
  sourceUrl         String?
  raw               Json
  aiSummary         String?
  // Bumped by ingest whenever match-relevant content changes; part of the
  // (profileVersion, tenderVersion) cache key that prevents LLM re-scoring.
  version           Int          @default(1)

  // Managed via raw migration SQL (see comment at top of file):
  searchVector Unsupported("tsvector")?
  embedding    Unsupported("vector(768)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer     Buyer?           @relation(fields: [buyerId], references: [id])
  awards    Award[]
  events    TenderEvent[]
  matches   Match[]
  followers FollowedTender[]
  documentAnalyses DocumentAnalysis[]

  @@index([status, deadlineAt])
  @@index([publishedAt])
  @@index([categoryCode])
  @@index([buyerId])
}

model Buyer {
  id      String   @id // OCDS party id
  name    String
  ruc     String?
  level   String?
  tenders Tender[]
  plannedPurchases PlannedPurchase[]
}

model Supplier {
  id     String  @id // OCDS party id
  name   String
  ruc    String?
  awards Award[]
}

model Award {
  id         String    @id // OCDS award id, namespaced by ocid to stay globally unique
  tenderId   String
  supplierId String?
  amount     Decimal?  @db.Decimal(20, 4)
  currency   String?
  date       DateTime?
  status     String?

  tender   Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([tenderId])
  @@index([supplierId])
}

model TenderEvent {
  id        String   @id @default(cuid())
  tenderId  String
  type      String // NEW | STATUS_CHANGE | DEADLINE_CHANGE | AMOUNT_CHANGE
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId, createdAt])
}

model SyncState {
  job       String    @id // "ocds_incremental" | "reconcile" | "backfill_2024" | ...
  lastRunAt DateTime?
  watermark DateTime? // last successfully covered publication date
  cursor    String? // page/offset for resuming an interrupted run
  status    String    @default("ok") // ok | running | error
  lastError String?
  updatedAt DateTime  @updatedAt
}

// ── Phase 4: profiles + AI matching ─────────────────────────────────

enum MatchAction {
  NONE
  SAVED
  BIDDING
  DISMISSED
}

enum MatchVerdict {
  STRONG
  POSSIBLE
  WEAK
  NO
}

model CompanyProfile {
  id          String @id @default(cuid())
  // Anonymous access credential kept in the browser's localStorage until Phase 5
  // auth migrates the profile to a User (docs/03). Never expose other profiles.
  anonToken   String @unique @default(cuid())
  userId      String? // set on first login (docs/03: anon profile migrates in)
  name        String
  description String // free text: what the company does, in their words
  categoryCodes   String[]
  keywords        String[]
  excludeKeywords String[]
  departments     String[] // geo scope, empty = all
  amountMin       Decimal? @db.Decimal(20, 4)
  amountMax       Decimal? @db.Decimal(20, 4)
  certifications  String[]
  // Bumped on every match-relevant edit; cache key half (see Tender.version).
  version         Int      @default(1)

  // pgvector column managed by raw migration SQL, dim = EMBEDDING_DIM:
  embedding Unsupported("vector(768)")?

  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches       Match[]
  savedSearches SavedSearch[]
  followedTenders FollowedTender[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId])
}

model Match {
  id         String       @id @default(cuid())
  profileId  String
  tenderId   String
  score      Int // 0-100
  verdict    MatchVerdict
  fitReasons String[] // LLM explanation, user locale (docs/04 schema)
  cautions   String[] // requirements that may disqualify
  // The (profile, tender) content versions this score was computed for. A pair is
  // re-sent to the LLM only when one of these no longer matches the live rows.
  profileVersion Int
  tenderVersion  Int
  userAction     MatchAction @default(NONE) // north-star metric
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  profile CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tender  Tender         @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([profileId, tenderId])
  @@index([profileId, score])
  @@index([tenderId])
}

// Every AI call is logged here (docs/04 cost guardrails). The daily budget kill
// switch sums estCostUsd for the current America/Asuncion day.
model AiUsage {
  id           String   @id @default(cuid())
  provider     String // gemini | anthropic
  model        String
  purpose      String // embed | judge | summarize | suggest_categories | analyze_document
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  estCostUsd   Decimal  @db.Decimal(12, 8)
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([purpose, createdAt])
}

// Thumbs up/down on AI output (summary quality, match reasoning) — docs/04
// feedback loop. Kept free-form; analyzed on /admin/ai.
model AiFeedback {
  id        String   @id @default(cuid())
  subject   String // summary | match
  tenderId  String?
  profileId String?
  helpful   Boolean
  comment   String?
  createdAt DateTime @default(now())

  @@index([subject, createdAt])
}

// ── Phase 5: accounts, saved searches, alerts ───────────────────────

enum Plan {
  FREE
  PRO
  BUSINESS
  AGENCY
}

// PHASE-F1: WhatsApp joins email as a second delivery channel. The enum names the
// *combination* rather than being a set, because a user picks one option in
// /cuenta; `channelsFor()` in src/lib/alerts/channels.ts expands it.
enum AlertChannel {
  EMAIL
  WHATSAPP
  EMAIL_AND_WHATSAPP
  NONE
}

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

// PHASE-F1: lifecycle of a user's WhatsApp number as an alert destination.
// UNVERIFIED  — no number, or a number that never completed the OTP step
// PENDING     — OTP sent, awaiting the code
// VERIFIED    — deliverable; the only state the alert engine will send to
// FAILED      — too many consecutive provider delivery failures (bad/blocked number)
// OPTED_OUT   — the user replied STOP/BAJA on WhatsApp, or removed the number here
enum WhatsappStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
  OPTED_OUT
}

// PHASE-F1: WhatsApp Business API delivery is async and stateful. Providers report
// state transitions over a webhook, out of order and sometimes more than once, so
// each state has a monotonic rank (src/lib/whatsapp/deliveryState.ts) and a late
// `sent` can never overwrite an already-recorded `read`.
enum WhatsappDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  UNDELIVERED
  FAILED
}

// Auth.js v5 PrismaAdapter shape (email magic-link + Google OAuth). Field names
// and table layout follow the adapter's contract exactly — do not rename.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  locale        String         @default("es") // es | en (CLAUDE.md: es default)
  plan          Plan           @default(FREE)
  alertChannel  AlertChannel   @default(EMAIL)
  alertFrequency AlertFrequency @default(DAILY)
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  // Set by the webhook on checkout/renewal/cancellation (PHASE-6 #2). Grace
  // period on payment failure is handled by Stripe's own retry schedule; we only
  // downgrade `plan` when Stripe tells us the subscription is truly gone.
  subscriptionStatus     String? // active | past_due | canceled | ...
  currentPeriodEnd       DateTime?
  // B2B bank-transfer deals (docs/06 risk B4): an admin flips this instead of
  // routing through Stripe; billing checks skip the Stripe state for these users.
  manualBilling          Boolean        @default(false)
  emailBounced  Boolean        @default(false) // set on hard bounce; stops sends

  // ── PHASE-F1: WhatsApp alert channel (Business+ only, see plan.ts) ──────
  // E.164 with the leading "+", e.g. +595981123456. Never store the provider's
  // "whatsapp:" prefix — that is a transport detail of src/lib/whatsapp/.
  whatsappPhone   String?
  whatsappStatus  WhatsappStatus @default(UNVERIFIED)
  // OTP opt-in (PHASE-F1 #5). The code is short-lived and single-purpose; it is
  // cleared on success, expiry, or too many attempts.
  whatsappOtpHash      String?
  whatsappOtpExpiresAt DateTime?
  whatsappOtpAttempts  Int       @default(0)
  // Consecutive failed deliveries reported by the provider webhook. At
  // WHATSAPP_MAX_DELIVERY_FAILURES the status flips to FAILED and sends stop —
  // a bouncing number must never be retried forever (PHASE-F1 #3).
  whatsappFailureCount Int       @default(0)
  whatsappVerifiedAt   DateTime?
  whatsappOptOutAt     DateTime?

  accounts      Account[]
  sessions      Session[]
  profiles      CompanyProfile[]
  savedSearches SavedSearch[]
  followedTenders FollowedTender[]
  alertLogs     AlertLog[]
  documentAnalyses DocumentAnalysis[]
  whatsappMessages WhatsappMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model SavedSearch {
  id       String  @id @default(cuid())
  userId   String
  // Which of the account's CompanyProfiles this search belongs to (Phase F2:
  // multi-profile). Null for searches saved before F2 shipped — they behave as
  // account-wide until the user re-saves them under a specific profile.
  profileId String?
  name     String
  params   Json // serialized /licitaciones filter state (docs/03)
  alerting Boolean @default(true)

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CompanyProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([profileId])
}

// 🔔 follow on tender detail (Phase 3 had this in localStorage only). Logged-in
// users persist here; TenderEvents (Phase 1) drive "changed" alerts for follows.
model FollowedTender {
  id       String @id @default(cuid())
  userId   String
  // Phase F2: which CompanyProfile this follow belongs to (null = pre-F2 rows,
  // treated as account-wide).
  profileId String?
  tenderId String

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CompanyProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tender  Tender          @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, profileId, tenderId])
  @@index([tenderId])
  @@index([profileId])
}

// Dedupe + audit of sent alerts (docs/03). One row per (user, tender, channel,
// reason) — re-running the alert job never double-sends the same alert. Scoped by
// `reason` (not just tenderId) so a tender can still earn a fresh, distinct alert
// later in its life — e.g. a "match" alert while OPEN, then an "award" alert once
// AWARDED (PHASE-F4) — without either suppressing the other.
model AlertLog {
  id       String   @id @default(cuid())
  userId   String
  tenderId String
  channel  String // "email"
  reason   String // "saved_search" | "match" | "tender_changed" | "award"
  sentAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenderId, channel, reason])
  @@index([userId, sentAt])
}

// PHASE-F1: one row per outbound WhatsApp message, so delivery state is
// auditable and a webhook can find the message it is reporting on. The provider
// id is the join key (Twilio MessageSid / 360dialog message id); it is nullable
// only for the brief window before the send API responds, and for the dev
// transport which has no real ids.
model WhatsappMessage {
  id                String                 @id @default(cuid())
  userId            String
  providerName      String // "twilio" | "dev" | ...
  providerMessageId String?                @unique
  toPhone           String
  template          String // template key (see src/lib/whatsapp/templates.ts)
  purpose           String // "digest" | "deadline" | "verification"
  status            WhatsappDeliveryStatus @default(QUEUED)
  errorCode         String?
  errorMessage      String?
  itemCount         Int                    @default(0)
  createdAt         DateTime               @default(now())
  statusUpdatedAt   DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

// ── Phase 6: billing, document analysis, admin ──────────────────────

// "Analizar pliego" (PHASE-6 #4, Business tier): cached per (tenderId,
// documentsUrl) so re-analysis is never re-billed against the quota; counted
// per user per calendar month for the quota check.
model DocumentAnalysis {
  id           String   @id @default(cuid())
  userId       String
  tenderId     String
  documentsUrl String
  checklist    Json // structured requirements checklist (docs/04)
  createdAt    DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([tenderId, documentsUrl])
  @@index([userId, createdAt])
}

model ExchangeRate {
  // Daily PYG-per-USD rate (docs/03). Amounts are stored in PYG; USD filter input is
  // converted using the latest available rate. Populated by a small job later; until
  // then the API falls back to env DEFAULT_PYG_PER_USD.
  date      DateTime @id @db.Date
  pygPerUsd Decimal  @db.Decimal(14, 4)
  createdAt DateTime @default(now())
}

// ── Phase F3: PAC early-warning ─────────────────────────────────────

// DNCP `planificaciones` (Plan Anual de Contrataciones) entries — agencies'
// *intent* to buy something, published months before the actual tender/OCDS
// release exists (docs/07 #1). Mirrors Tender's shape (CLAUDE.md rule 4: `raw`
// keeps the full source JSON; normalized columns are a recomputable
// projection). Ingested by the same 30-min worker cadence as tenders
// (src/worker/planningIngest.ts), through the shared DncpClient.
//
// Business-tier feed only (src/lib/plan.ts `plannedPurchases`) — the data itself
// is never gated for tenders (PHASE-6 rule), but PAC early-warning is explicitly
// sold as a Business-tier hook (docs/07, PLAN.md Phase F #3), so it is gated here
// unlike Tender.
model PlannedPurchase {
  id                String   @id @default(cuid())
  // DNCP's PAC entry id — the natural external key; there is usually no OCDS
  // ocid yet since no tender/convocatoria has been convened.
  externalId        String   @unique
  // Populated only if/when DNCP links this PAC line to a real OCDS process —
  // lets the ingest/UI cross-reference once the tender goes live.
  ocid              String?
  year              Int?
  title             String
  description       String?
  status            String? // raw DNCP estado (e.g. PROGRAMADO, CONVOCADO, CANCELADO) — not yet a confirmed enum, see planning.ts
  buyerId           String?
  buyerName         String? // denormalized for list display, mirrors Tender.buyerName
  categoryCode      String?
  categoryName      String?
  procurementMethod String?
  estimatedAmount   Decimal? @db.Decimal(20, 4)
  currency          String   @default("PYG")
  department        String?
  estimatedQuarter  String? // e.g. "2026-Q4"
  estimatedDate     DateTime?
  publishedAt       DateTime?
  raw               Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer Buyer? @relation(fields: [buyerId], references: [id])

  @@index([status, estimatedDate])
  @@index([categoryCode])
  @@index([buyerId])
  @@index([publishedAt])
}
