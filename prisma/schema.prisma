// ParaOU data model — Phase 1 (ingestion). See docs/03-data-model.md.
// Later phases add User / CompanyProfile / Match / SavedSearch / billing models.
//
// Special columns managed by hand-written SQL in the migration (Prisma can't model
// them): Tender.searchVector is a GENERATED tsvector (spanish + unaccent) with a GIN
// index; Tender.embedding is a pgvector column with an HNSW cosine index (populated
// in Phase 4). They are declared here as Unsupported(...) so the client is aware of
// them and migrate diff stays consistent.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, unaccent, pg_trgm]
}

enum TenderStatus {
  PLANNED
  OPEN
  CLOSED
  AWARDED
  CONTRACTED
  CANCELLED
  UNSUCCESSFUL
}

model Tender {
  id                String       @id @default(cuid())
  ocid              String       @unique
  dncpId            String?
  title             String
  description       String?
  status            TenderStatus
  buyerId           String?
  buyerName         String? // denormalized for FTS + list display
  categoryCode      String?
  categoryName      String?
  procurementMethod String?
  amountMin         Decimal?     @db.Decimal(20, 4)
  amountMax         Decimal?     @db.Decimal(20, 4)
  currency          String       @default("PYG")
  department        String?
  publishedAt       DateTime?
  deadlineAt        DateTime?
  inquiryDeadlineAt DateTime?
  documentsUrl      String?
  sourceUrl         String?
  raw               Json
  aiSummary         String?

  // Managed via raw migration SQL (see comment at top of file):
  searchVector Unsupported("tsvector")?
  embedding    Unsupported("vector(768)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer    Buyer?        @relation(fields: [buyerId], references: [id])
  awards   Award[]
  events   TenderEvent[]
  matches  Match[]
  follows  Follow[]
  alertLog AlertLog[]

  @@index([status, deadlineAt])
  @@index([publishedAt])
  @@index([categoryCode])
  @@index([buyerId])
}

model Buyer {
  id      String   @id // OCDS party id
  name    String
  ruc     String?
  level   String?
  tenders Tender[]
}

model Supplier {
  id     String  @id // OCDS party id
  name   String
  ruc    String?
  awards Award[]
}

model Award {
  id         String    @id // OCDS award id, namespaced by ocid to stay globally unique
  tenderId   String
  supplierId String?
  amount     Decimal?  @db.Decimal(20, 4)
  currency   String?
  date       DateTime?
  status     String?

  tender   Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([tenderId])
  @@index([supplierId])
}

model TenderEvent {
  id        String   @id @default(cuid())
  tenderId  String
  type      String // NEW | STATUS_CHANGE | DEADLINE_CHANGE | AMOUNT_CHANGE
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId, createdAt])
}

model SyncState {
  job       String    @id // "ocds_incremental" | "reconcile" | "backfill_2024" | ...
  lastRunAt DateTime?
  watermark DateTime? // last successfully covered publication date
  cursor    String? // page/offset for resuming an interrupted run
  status    String    @default("ok") // ok | running | error
  lastError String?
  updatedAt DateTime  @updatedAt
}

model ExchangeRate {
  // Daily PYG-per-USD rate (docs/03). Amounts are stored in PYG; USD filter input is
  // converted using the latest available rate. Populated by a small job later; until
  // then the API falls back to env DEFAULT_PYG_PER_USD.
  date      DateTime @id @db.Date
  pygPerUsd Decimal  @db.Decimal(14, 4)
  createdAt DateTime @default(now())
}

// ─── Phase 4: AI matching (docs/04) ─────────────────────────────────────────

enum MatchAction {
  NONE
  SAVED
  BIDDING
  DISMISSED
}

model CompanyProfile {
  id     String  @id @default(cuid())
  // Pre-auth identity: a browser-generated token, set before Phase 5 signup and
  // kept afterward (harmless once linked — see src/lib/api/identity.ts). `userId`
  // is filled in the first time the visitor signs in (anon -> account migration).
  anonId String? @unique
  userId String?
  name   String
  description     String // free text; drives the embedding
  categoryCodes   String[]
  keywords        String[]
  excludeKeywords String[]
  departments     String[]
  amountMin       Decimal? @db.Decimal(20, 4)
  amountMax       Decimal? @db.Decimal(20, 4)
  certifications  String[]

  // Managed via raw migration SQL (see prisma/migrations/*_init comment):
  embedding Unsupported("vector(768)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches       Match[]
  savedSearches SavedSearch[]

  @@index([userId])
}

model Match {
  id        String @id @default(cuid())
  profileId String
  tenderId  String
  score     Int // 0-100
  verdict   String // strong|possible|weak|no
  reasoning String // LLM explanation, user-facing, es-PY
  cautions  String[]

  userAction MatchAction @default(NONE) // north-star metric (docs/03)

  // Cache key: skip re-scoring while both snapshots still match the live rows
  // (docs/04: "cache forever per profile-version, tender-version").
  profileVersion DateTime
  tenderVersion  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tender  Tender         @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([profileId, tenderId])
  @@index([profileId, score])
  @@index([tenderId])
}

model AiUsage {
  id               String   @id @default(cuid())
  provider         String // gemini | anthropic | mock
  model            String
  purpose          String // embed_tender | embed_profile | judge_match | summarize | suggest_categories
  promptTokens     Int?
  completionTokens Int?
  estCostUsd       Decimal  @db.Decimal(10, 6)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([purpose, createdAt])
}

// ─── Phase 5: accounts, saved searches, alerts (docs/03, docs/05 §Alert emails) ──

enum AlertFrequency {
  INSTANT // every worker cycle that finds new items
  DAILY
  WEEKLY
  NONE // muted
}

enum AlertChannel {
  EMAIL
  NONE
}

// Auth.js (NextAuth v5) adapter models — field/relation shapes verified against
// the official @auth/prisma-adapter schema (packages/adapter-prisma/prisma/
// schema.prisma in nextauthjs/next-auth) on 2026-07-16. WebAuthn/Authenticator
// omitted — only Email (magic link) + Google are used (PHASE-5 step 1).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // App-specific fields (docs/03 User model + PHASE-5 step 6).
  locale         String         @default("es")
  alertChannel   AlertChannel   @default(EMAIL)
  alertFrequency AlertFrequency @default(DAILY)
  lastDigestAt   DateTime?
  createdAt      DateTime       @default(now())

  accounts Account[]
  sessions Session[]
  profiles CompanyProfile[]
  follows  Follow[]
  alertLog AlertLog[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model SavedSearch {
  id        String  @id @default(cuid())
  profileId String
  name      String
  params    Json // serialized /licitaciones filter state
  alerting  Boolean @default(true)
  createdAt DateTime @default(now())

  profile CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Follow {
  id        String   @id @default(cuid())
  userId    String
  tenderId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([userId, tenderId])
  @@index([tenderId])
}

model AlertLog {
  id       String   @id @default(cuid())
  userId   String
  tenderId String
  channel  String // "EMAIL"
  sentAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([userId, tenderId, channel])
}
